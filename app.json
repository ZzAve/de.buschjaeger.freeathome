{
  "id": "de.buschjaeger.freeathome",
  "version": "0.0.1",
  "compatibility": ">=2.5.2",
  "sdk": 2,
  "name": {
    "en": "Bush Jeager Free@Home"
  },
  "description": {
    "en": "Adds support for Busch Jaeger's Free@home system and its connected devices to Homey"
  },
  "category": [
    "lights"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Julius van Dis",
    "email": "vandis.j@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "id": "busch_jaeger_connected",
        "title": {
          "en": "Api connection established",
          "nl": "Api verbinding gemaakt"
        }
      },
      {
        "id": "busch_jaeger_disconnected",
        "title": {
          "en": "Api connection lost",
          "nl": "Api verbinding verbroken"
        }
      }
    ]
  },
  "drivers": [
    {
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "list_icons"
          }
        },
        {
          "id": "list_icons",
          "navigation": {
            "prev": "list_devices",
            "next": "freeathome"
          }
        },
        {
          "id": "freeathome"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Log settings",
            "nl": "Log instellingen"
          },
          "children": [
            {
              "id": "debug_log",
              "type": "checkbox",
              "label": {
                "en": "Debug logs",
                "nl": "Debug logs"
              },
              "value": false,
              "hint": {
                "en": "Register debug logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van debug logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            },
            {
              "id": "info_log",
              "type": "checkbox",
              "label": {
                "en": "Info logs",
                "nl": "Info logs"
              },
              "value": false,
              "hint": {
                "en": "Register info logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van info logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            }
          ]
        }
      ],
      "id": "blind",
      "name": {
        "en": "Blinds"
      },
      "class": "blinds",
      "capabilities": [
        "windowcoverings_state",
        "windowcoverings_set"
      ],
      "images": {
        "large": "/drivers/shutter/assets/images/large.png",
        "small": "/drivers/shutter/assets/images/small.png"
      }
    },
    {
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "list_icons"
          }
        },
        {
          "id": "list_icons",
          "navigation": {
            "prev": "list_devices",
            "next": "freeathome"
          }
        },
        {
          "id": "freeathome"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Log settings",
            "nl": "Log instellingen"
          },
          "children": [
            {
              "id": "debug_log",
              "type": "checkbox",
              "label": {
                "en": "Debug logs",
                "nl": "Debug logs"
              },
              "value": false,
              "hint": {
                "en": "Register debug logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van debug logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            },
            {
              "id": "info_log",
              "type": "checkbox",
              "label": {
                "en": "Info logs",
                "nl": "Info logs"
              },
              "value": false,
              "hint": {
                "en": "Register info logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van info logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            }
          ]
        }
      ],
      "id": "dimmer",
      "name": {
        "en": "Dimmer"
      },
      "class": "light",
      "capabilities": [
        "dim",
        "onoff"
      ],
      "images": {
        "large": "/drivers/dimmer/assets/images/large.png",
        "small": "/drivers/dimmer/assets/images/small.png"
      }
    },
    {
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "list_icons"
          }
        },
        {
          "id": "list_icons",
          "navigation": {
            "prev": "list_devices",
            "next": "freeathome"
          }
        },
        {
          "id": "freeathome"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Log settings",
            "nl": "Log instellingen"
          },
          "children": [
            {
              "id": "debug_log",
              "type": "checkbox",
              "label": {
                "en": "Debug logs",
                "nl": "Debug logs"
              },
              "value": false,
              "hint": {
                "en": "Register debug logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van debug logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            },
            {
              "id": "info_log",
              "type": "checkbox",
              "label": {
                "en": "Info logs",
                "nl": "Info logs"
              },
              "value": false,
              "hint": {
                "en": "Register info logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van info logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            }
          ]
        }
      ],
      "id": "heating",
      "name": {
        "en": "Heating",
        "nl": "Verwarming"
      },
      "class": "heater",
      "capabilities": [
        "freeathome_heating"
      ],
      "images": {
        "large": "/drivers/heating/assets/images/large.png",
        "small": "/drivers/heating/assets/images/small.png"
      }
    },
    {
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "list_icons"
          }
        },
        {
          "id": "list_icons",
          "navigation": {
            "prev": "list_devices",
            "next": "freeathome"
          }
        },
        {
          "id": "freeathome"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Log settings",
            "nl": "Log instellingen"
          },
          "children": [
            {
              "id": "debug_log",
              "type": "checkbox",
              "label": {
                "en": "Debug logs",
                "nl": "Debug logs"
              },
              "value": false,
              "hint": {
                "en": "Register debug logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van debug logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            },
            {
              "id": "info_log",
              "type": "checkbox",
              "label": {
                "en": "Info logs",
                "nl": "Info logs"
              },
              "value": false,
              "hint": {
                "en": "Register info logs for this device. These will show up in the app's settings",
                "nl": "Wegschrijven van info logs for dit apparaat. De logs zijn te vinden in de app instellingen"
              }
            }
          ]
        }
      ],
      "id": "switch",
      "name": {
        "en": "Switch"
      },
      "class": "light",
      "capabilities": [
        "onoff"
      ],
      "images": {
        "large": "/drivers/switch/assets/images/large.png",
        "small": "/drivers/switch/assets/images/small.png"
      }
    }
  ],
  "capabilities": {
    "freeathome_heating": {
      "id": "freeathome_heating",
      "type": "number",
      "title": {
        "en": "Heating level"
      },
      "uiComponent": "slider",
      "getable": true,
      "setable": true,
      "min": 0,
      "max": 100,
      "step": 25
    }
  }
}